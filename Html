:root{
  --bg:#050814;
  --bg2:#080d1c;
  --text:#f4f7ff;
  --muted:#98a5c1;
  --line:rgba(148,170,255,.14);
  --blue:#4d8dff;
  --purple:#8b5cf6;
  --cyan:#39d9ff;
  --glass:rgba(11,18,38,.62);
  --shadow:0 25px 80px rgba(0,0,0,.35);
  --radius:22px;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Inter,system-ui,sans-serif;
  background:
    radial-gradient(circle at 75% 10%,#14285c33,transparent 30%),
    var(--bg);
  color:var(--text);
  line-height:1.6;
  overflow-x:hidden;
}

body.light{
  --bg:#f6f8ff;
  --bg2:#fff;
  --text:#111827;
  --muted:#526078;
  --line:rgba(20,40,90,.14);
  --glass:rgba(255,255,255,.7);
}

a{
  color:inherit;
  text-decoration:none;
}

.container{
  width:min(1120px,92%);
  margin:auto;
}

.noise{
  position:fixed;
  inset:0;
  pointer-events:none;
  opacity:.025;
  z-index:20;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
}

.cursor-glow{
  position:fixed;
  width:260px;
  height:260px;
  border-radius:50%;
  background:radial-gradient(circle,#4d8dff18,transparent 65%);
  pointer-events:none;
  transform:translate(-50%,-50%);
  z-index:0;
}

/* NAVBAR */

.nav-wrap{
  position:fixed;
  top:0;
  left:0;
  right:0;
  z-index:50;
  background:#050814b8;
  backdrop-filter:blur(18px);
  border-bottom:1px solid var(--line);
}

.nav{
  height:72px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.brand{
  font-family:"Space Grotesk";
  font-weight:700;
  font-size:16px;
  display:flex;
  align-items:center;
  gap:10px;
}

.brand span{
  display:grid;
  place-items:center;
  width:32px;
  height:32px;
  border-radius:10px;
  background:linear-gradient(135deg,var(--blue),var(--purple));
  font-size:12px;
}

.nav-links{
  display:flex;
  gap:28px;
  font-size:13px;
  color:var(--muted);
}

.nav-links a{
  transition:.25s;
}

.nav-links a:hover,
.nav-links a.active{
  color:var(--text);
}

.theme-btn,
.menu-btn{
  border:1px solid var(--line);
  background:transparent;
  color:var(--text);
  width:38px;
  height:38px;
  border-radius:50%;
  cursor:pointer;
}

.menu-btn{
  display:none;
}

/* HERO */

.hero{
  min-height:100vh;
  display:grid;
  grid-template-columns:1fr 1fr;
  align-items:center;
  gap:20px;
  padding-top:72px;
  position:relative;
}

.eyebrow{
  color:#76a5ff;
  font-size:11px;
  letter-spacing:2px;
  font-weight:700;
  margin-bottom:18px;
}

.dot{
  display:inline-block;
  width:7px;
  height:7px;
  background:#55e6a5;
  border-radius:50%;
  margin-right:8px;
  box-shadow:0 0 14px #55e6a5;
}

.hero h1,
.section-heading h2{
  font-family:"Space Grotesk";
  font-weight:700;
  letter-spacing:-2px;
  line-height:1.02;
}

.hero h1{
  font-size:clamp(50px,7vw,88px);
}

.gradient-text{
  background:linear-gradient(
    100deg,
    #fff 0%,
    #5f9cff 45%,
    #a977ff 90%
  );
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.hero-sub{
  max-width:590px;
  color:var(--muted);
  font-size:18px;
  margin:24px 0;
}

.hero-sub b{
  color:var(--text);
}

.hero-actions{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  border:1px solid var(--line);
  padding:12px 18px;
  border-radius:999px;
  font-weight:600;
  font-size:13px;
  cursor:pointer;
  transition:.3s;
}

.btn.primary{
  background:linear-gradient(110deg,#397cff,#8255ee);
  box-shadow:0 12px 35px #4d8dff22;
}

.btn.primary:hover{
  transform:translateY(-3px);
  box-shadow:0 18px 40px #4d8dff38;
}

.btn.ghost{
  background:rgba(255,255,255,.02);
}

.btn.ghost:hover{
  background:rgba(255,255,255,.06);
}

.quick-info{
  display:flex;
  gap:20px;
  flex-wrap:wrap;
  margin-top:32px;
  color:var(--muted);
  font-size:11px;
}

/* HERO ART */

.hero-art{
  height:570px;
  position:relative;
  display:grid;
  place-items:center;
}

.grid-glow{
  position:absolute;
  width:420px;
  height:420px;
  border-radius:50%;
  background:radial-gradient(circle,#376cff35,transparent 65%);
  filter:blur(4px);
}

.profile-placeholder{
  width:330px;
  height:440px;
  border:1px solid #6d8dff35;
  border-radius:170px 170px 35px 35px;
  background:linear-gradient(160deg,#172958,#0a1020);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  box-shadow:0 0 100px #4d8dff18;
  position:relative;
  overflow:hidden;
}

.profile-placeholder:before{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(135deg,transparent,#7b61ff12);
}

.initials{
  font-family:"Space Grotesk";
  font-size:110px;
  font-weight:700;
  background:linear-gradient(135deg,#fff,#6094ff,#9b6cff);
  -webkit-background-clip:text;
  color:transparent;
}

.profile-placeholder p{
  color:#7e8cac;
  font-size:12px;
}

.orb{
  position:absolute;
  border-radius:50%;
  filter:blur(1px);
}

.orb-a{
  width:90px;
  height:90px;
  background:#4d8dff35;
  top:60px;
  right:70px;
  animation:float 5s ease-in-out infinite;
}

.orb-b{
  width:50px;
  height:50px;
  background:#a15cff45;
  bottom:80px;
  left:70px;
  animation:float 4s ease-in-out infinite reverse;
}

.floating-card{
  position:absolute;
  display:flex;
  gap:10px;
  align-items:center;
  background:#0c1429c9;
  border:1px solid var(--line);
  backdrop-filter:blur(15px);
  padding:12px 16px;
  border-radius:15px;
  box-shadow:var(--shadow);
  font-size:12px;
  animation:float 4s ease-in-out infinite;
}

.floating-card span{
  display:grid;
  place-items:center;
  width:32px;
  height:32px;
  border-radius:9px;
  background:#356fff22;
  color:#71a2ff;
}

.floating-card small{
  display:block;
  color:var(--muted);
  font-size:9px;
}

.card-one{
  left:2%;
  top:31%;
}

.card-two{
  right:0;
  bottom:27%;
  animation-delay:-2s;
}

/* SECTIONS */

.section{
  padding:120px 0;
}

.section-heading{
  margin-bottom:45px;
}

.section-heading h2{
  font-size:clamp(38px,5vw,62px);
}

.section-heading.row{
  display:flex;
  justify-content:space-between;
  align-items:end;
}

.section-note{
  color:var(--muted);
  font-size:12px;
}

.glass{
  background:var(--glass);
  border:1px solid var(--line);
  box-shadow:var(--shadow);
  backdrop-filter:blur(16px);
}

/* ABOUT */

.about-grid{
  display:grid;
  grid-template-columns:1.5fr .7fr;
  gap:20px;
}

.about-text{
  padding:36px;
  border-radius:var(--radius);
  color:var(--muted);
}

.about-text p{
  font-size:16px;
  margin-bottom:18px;
}

.about-text strong{
  color:var(--text);
}

.about-stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  border-top:1px solid var(--line);
  margin-top:28px;
  padding-top:25px;
  gap:15px;
}

.about-stats b{
  font-family:"Space Grotesk";
  font-size:26px;
  color:var(--text);
  display:block;
}

.about-stats span{
  font-size:10px;
  color:var(--muted);
}

.quote-card{
  border-radius:var(--radius);
  padding:35px;
  background:linear-gradient(145deg,#162b62,#100d29);
  border:1px solid #688dff2b;
  position:relative;
  overflow:hidden;
}

.quote-card:after{
  content:"";
  position:absolute;
  width:170px;
  height:170px;
  border-radius:50%;
  right:-80px;
  bottom:-80px;
  background:#4d8dff24;
  filter:blur(5px);
}

.quote-mark{
  font-size:55px;
  color:#6196ff;
  line-height:.7;
}

.quote-card p{
  font-family:"Space Grotesk";
  font-size:23px;
  line-height:1.4;
  margin:20px 0;
}

.line{
  display:block;
  width:38px;
  height:2px;
  background:linear-gradient(90deg,#5b94ff,#9b63ff);
  margin-bottom:10px;
}

.quote-card small{
  color:#98a5c1;
}

/* SKILLS */

.skills-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px;
}

.skill-card{
  padding:23px;
  border-radius:18px;
  transition:.3s;
}

.skill-card:hover,
.project-card:hover{
  transform:translateY(-7px);
  border-color:#6b94ff45;
}

.skill-icon{
  height:45px;
  width:45px;
  display:grid;
  place-items:center;
  border-radius:13px;
  background:#3e72ff14;
  color:#70a0ff;
  font-weight:800;
  margin-bottom:15px;
}

.skill-card h3{
  font-size:15px;
}

.skill-card p{
  color:var(--muted);
  font-size:11px;
  margin:4px 0 15px;
}

.bar{
  height:4px;
  background:#ffffff0d;
  border-radius:5px;
  overflow:hidden;
}

.bar i{
  display:block;
  height:100%;
  border-radius:5px;
  background:linear-gradient(90deg,#4d8dff,#9c63ff);
}

/* PROJECTS */

.projects-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
}

.project-card{
  border-radius:20px;
  padding:16px;
  transition:.35s;
}

.project-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:14px;
}

.tag{
  font-size:9px;
  letter-spacing:1.4px;
  color:#75a5ff;
  border:1px solid #5e8cff30;
  padding:5px 8px;
  border-radius:999px;
}

.project-number{
  color:#53617c;
  font-size:11px;
}

.project-visual{
  height:170px;
  border-radius:14px;
  margin-bottom:18px;
  display:grid;
  place-items:center;
  overflow:hidden;
  border:1px solid var(--line);
}

.visual-ai{
  background:
    radial-gradient(circle at 50% 50%,#406dff2e,transparent 50%),
    #0a1020;
}

.pulse{
  font-family:"Space Grotesk";
  font-size:45px;
  font-weight:700;
  color:#75a5ff;
  text-shadow:0 0 30px #4d8dff;
}

.mini-bars{
  position:absolute;
  display:flex;
  gap:5px;
  margin-top:90px;
}

.mini-bars i{
  display:block;
  width:8px;
  background:#4d8dff55;
  border-radius:5px;
}

.mini-bars i:nth-child(1){
  height:20px;
}

.mini-bars i:nth-child(2){
  height:35px;
}

.mini-bars i:nth-child(3){
  height:55px;
}

.mini-bars i:nth-child(4){
  height:30px;
}

.visual-web{
  background:linear-gradient(145deg,#101a35,#17102d);
}

.browser{
  width:70%;
  padding:18px;
  background:#091022;
  border:1px solid #7195ff26;
  border-radius:10px;
  font-size:11px;
  color:#78a3ff;
  box-shadow:0 15px 30px #0004;
}

.browser span{
  display:block;
  height:4px;
  background:#33466c;
  margin-top:8px;
  border-radius:3px;
}

.visual-code{
  background:#080e1b;
  padding:25px;
  display:block;
}

.visual-code code{
  font:12px/1.8 monospace;
  color:#82aaff;
}

.project-card h3{
  font-size:17px;
}

.project-card>p{
  color:var(--muted);
  font-size:11px;
  margin:7px 0 14px;
  min-height:54px;
}

.tech{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
  margin-bottom:15px;
}

.tech span{
  font-size:9px;
  color:#8f9db8;
  background:#ffffff06;
  padding:5px 7px;
  border-radius:6px;
}

.project-link{
  font-size:11px;
  color:#77a5ff;
}

/* EDUCATION / TIMELINE */

.timeline{
  max-width:800px;
  border-left:1px solid #5688ff40;
  padding-left:35px;
  margin-left:12px;
}

.timeline-item{
  position:relative;
  padding-bottom:55px;
}

.timeline-dot{
  position:absolute;
  left:-42px;
  top:4px;
  width:14px;
  height:14px;
  border-radius:50%;
  background:#5a91ff;
  box-shadow:0 0 22px #4d8dff;
}

.timeline-item span{
  font-size:10px;
  letter-spacing:1px;
  color:#72a0ff;
}

.timeline-item h3{
  font-family:"Space Grotesk";
  font-size:23px;
  margin:7px 0;
}

.timeline-item p{
  color:var(--muted);
  font-size:13px;
}

/* CONTACT */

.contact-section{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:55px;
  align-items:center;
}

.contact-copy h2{
  font-family:"Space Grotesk";
  font-size:clamp(40px,5vw,62px);
  line-height:1.03;
  letter-spacing:-2px;
}

.contact-copy>p:not(.eyebrow){
  color:var(--muted);
  margin:22px 0;
  max-width:480px;
}

.socials{
  display:flex;
  gap:10px;
}

.socials a{
  font-size:11px;
  color:#9fb0d1;
  border:1px solid var(--line);
  padding:9px 13px;
  border-radius:999px;
  transition:.25s;
}

.socials a:hover{
  color:#fff;
  border-color:#6f98ff55;
}

.contact-form{
  padding:25px;
  border-radius:20px;
}

.contact-form label{
  display:block;
  font-size:10px;
  color:#8d9bb7;
  margin-bottom:15px;
}

.contact-form input,
.contact-form textarea{
  width:100%;
  margin-top:7px;
  border:1px solid var(--line);
  background:#060c1b80;
  color:var(--text);
  padding:12px;
  border-radius:10px;
  outline:none;
  font:inherit;
  font-size:12px;
  resize:vertical;
}

.contact-form input:focus,
.contact-form textarea:focus{
  border-color:#6192ff66;
}

.contact-form .btn{
  width:100%;
  margin-top:2px;
}

.form-note{
  font-size:9px;
  color:#697792;
  text-align:center;
  margin-top:9px;
}

/* FOOTER */

footer{
  border-top:1px solid var(--line);
  padding:25px 0;
  color:#63708b;
  font-size:10px;
}

.footer-inner{
  display:flex;
  justify-content:space-between;
}

/* ANIMATIONS */

.reveal{
  opacity:0;
  transform:translateY(25px);
  transition:
    opacity .8s ease,
    transform .8s ease;
}

.reveal.show{
  opacity:1;
  transform:none;
}

.delay-1{
  transition-delay:.12s;
}

.delay-2{
  transition-delay:.24s;
}

@keyframes float{
  50%{
    transform:translateY(-12px);
  }
}

/* MOBILE */

@media(max-width:850px){

  .nav-links{
    position:fixed;
    top:72px;
    left:4%;
    right:4%;
    display:none;
    flex-direction:column;
    padding:20px;
    background:#080e1dF5;
    border:1px solid var(--line);
    border-radius:16px;
  }

  .nav-links.open{
    display:flex;
  }

  .menu-btn{
    display:block;
    margin-left:auto;
    margin-right:8px;
  }

  .hero{
    grid-template-columns:1fr;
    padding-top:130px;
  }

  .hero-art{
    height:430px;
    order:-1;
  }

  .profile-placeholder{
    width:240px;
    height:330px;
  }

  .initials{
    font-size:75px;
  }

  .floating-card{
    transform:scale(.85);
  }

  .card-one{
    left:0;
  }

  .card-two{
    right:0;
  }

  .about-grid,
  .contact-section{
    grid-template-columns:1fr;
  }

  .skills-grid,
  .projects-grid{
    grid-template-columns:1fr 1fr;
  }

  .section-heading.row{
    align-items:start;
    gap:20px;
    flex-direction:column;
  }
}

@media(max-width:560px){

  .hero h1{
    font-size:51px;
  }

  .hero-sub{
    font-size:15px;
  }

  .quick-info{
    font-size:10px;
  }

  .hero-art{
    height:380px;
  }

  .skills-grid,
  .projects-grid{
    grid-template-columns:1fr;
  }

  .about-stats{
    grid-template-columns:1fr;
  }

  .footer-inner{
    flex-direction:column;
    gap:8px;
  }

  .section{
    padding:85px 0;
  }

  .contact-copy h2{
    font-size:45px;
  }
}
